{
  "name": "1229-electricals",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"],
    "html_handling": "auto-trailing-slash"
  },
  "kv_namespaces": [{ "binding": "STORE" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "1229-media" }],
  "observability": { "enabled": false }
}
